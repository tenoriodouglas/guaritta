NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://guaritta:guaritta@localhost:5432/guaritta

# Auth
JWT_SECRET=change-me-with-at-least-32-characters!!
JWT_EXPIRES_IN=8h

# Initial admin created by `npm run db:seed`
ADMIN_EMAIL=admin@guaritta.local
ADMIN_PASSWORD=change-me-now

# License plate recognition: "none" (plate text sent by camera) or "platerecognizer"
ALPR_PROVIDER=none
ALPR_API_TOKEN=
ALPR_MIN_CONFIDENCE=0.8

# Seconds a pending access request waits for an operator before expiring
ACCESS_REQUEST_TTL_SECONDS=120
